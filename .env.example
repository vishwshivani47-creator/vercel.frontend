# ==============================================================================
# HUMORPHIC LAB 3D PLATFORM - ROOT ENVIRONMENT CONFIGURATION
# Copy this file to .env before starting services
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_super_secure_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django Backend Configuration
DJANGO_SECRET_KEY=django-insecure-change-me-to-a-random-50-character-secret-key-in-prod
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,web,.onrender.com
DJANGO_SETTINGS_MODULE=config.settings.production

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Simple JWT Authentication Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend Configuration
# Production (Render Backend):
NEXT_PUBLIC_API_URL=https://humorphic-lab-backend.onrender.com/api/v1
# Local Development:
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_NAME=Humorphic Lab
NEXT_PUBLIC_ENABLE_3D_DRACO=true
NEXT_PUBLIC_FALLBACK_FRAMES_COUNT=300
